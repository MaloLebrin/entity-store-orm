{
  "name": "entity-store",
  "version": "1.0.0",
  "description": "Agnostic ORM with adapters for different state managers",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r dev",
    "test": "pnpm -r test",
    "test:watch": "pnpm -r test:watch",
    "test:coverage": "pnpm -r test:coverage",
    "clean": "pnpm -r clean",
    "type-check": "pnpm -r type-check",
    "lint": "biome check .",
    "format": "biome format --write .",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "keywords": [
    "orm",
    "state-management",
    "typescript",
    "agnostic",
    "entity-store",
    "redux",
    "zustand",
    "jotai",
    "valtio"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.15.0",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.6.4",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "pinia": "^3.0.3",
    "publint": "^0.3.25",
    "tsup": "^9.0.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "volta": {
    "node": "24.6.0"
  }
}
