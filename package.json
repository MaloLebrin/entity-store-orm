{
  "name": "entity-store",
  "version": "0.0.0",
  "description": "Immutable normalized entity store with adapters for Pinia, Zustand, Redux Toolkit, Jotai and Valtio",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r dev",
    "test": "pnpm -r test",
    "test:watch": "pnpm -r test:watch",
    "test:coverage": "pnpm -r test:coverage",
    "clean": "pnpm -r clean",
    "type-check": "pnpm -r type-check",
    "lint": "biome check .",
    "format": "biome format --write .",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "check:package": "pnpm -r check:package",
    "test:consumer": "bash tests/consumer/run.sh",
    "size": "size-limit",
    "bench": "pnpm --filter @entity-store/test-bench bench",
    "bench:check": "pnpm --filter @entity-store/test-bench bench:check",
    "docs:api": "typedoc",
    "docs:dev": "vitepress dev docs",
    "docs:site": "vitepress build docs",
    "docs": "pnpm build && pnpm docs:api && pnpm docs:site"
  },
  "keywords": [
    "orm",
    "state-management",
    "typescript",
    "agnostic",
    "entity-store",
    "redux",
    "zustand",
    "jotai",
    "valtio"
  ],
  "author": "Malo Lebrin",
  "license": "MIT",
  "packageManager": "pnpm@12.16.1",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.6.6",
    "@changesets/cli": "^3.0.3",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "pinia": "catalog:",
    "publint": "^0.3.25",
    "size-limit": "^14.3.0",
    "tsup": "^9.0.0",
    "typedoc": "^0.28.20",
    "typescript": "catalog:",
    "vitepress": "^1.6.4",
    "vitest": "catalog:"
  },
  "volta": {
    "node": "24.6.0"
  }
}
