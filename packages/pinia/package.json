{
  "name": "@entity-store/pinia",
  "version": "1.0.0",
  "description": "Pinia adapter for entity-store",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm clean && pnpm build",
    "type-check": "tsc --noEmit",
    "check:package": "publint && attw --pack . --profile node16"
  },
  "keywords": [
    "pinia",
    "entity-management",
    "state-management",
    "vue"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "pinia": "^3.0.0 || ^4.0.0"
  },
  "dependencies": {
    "@entity-store/core": "workspace:*",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "pinia": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "module": "./dist/index.js",
  "sideEffects": false
}
