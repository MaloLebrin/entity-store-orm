{
  "name": "@entity-store/core",
  "version": "0.0.0",
  "description": "Core entity management functions - agnostic to state managers",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm clean && pnpm build",
    "type-check": "tsc --noEmit",
    "check:package": "publint && attw --pack . --profile node16"
  },
  "keywords": [
    "entity-management",
    "state-management",
    "typescript",
    "agnostic"
  ],
  "author": "Malo Lebrin",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "module": "./dist/index.js",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaloLebrin/entity-store-orm.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/MaloLebrin/entity-store-orm#readme",
  "bugs": {
    "url": "https://github.com/MaloLebrin/entity-store-orm/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
