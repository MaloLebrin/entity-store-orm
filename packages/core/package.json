{
  "name": "@entity-store/core",
  "version": "1.0.0",
  "description": "Core entity management functions - agnostic to state managers",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm clean && pnpm build",
    "type-check": "tsc --noEmit",
    "check:package": "publint && attw --pack . --profile node16"
  },
  "keywords": [
    "entity-management",
    "state-management",
    "typescript",
    "agnostic"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "module": "./dist/index.js",
  "sideEffects": false
}
