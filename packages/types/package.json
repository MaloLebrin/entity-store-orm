{
  "name": "@entity-store/types",
  "version": "1.0.0",
  "description": "Shared types and interfaces for entity-store",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm clean && pnpm build",
    "type-check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "check:package": "publint && attw --pack . --profile node16"
  },
  "keywords": [
    "typescript",
    "types",
    "entity-management"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  },
  "module": "./dist/index.js",
  "sideEffects": false
}
